msgstr "Pengaturan pencarian tersimpan"

#: cards:1
msgid "System configuration for saving searches"
msgstr "Konfigurasi sistem untuk menyimpan pencarian"

#: cards:1
msgid "Settings System Defaults"
msgstr "Pengaturan bawaan sistem"

